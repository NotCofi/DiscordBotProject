onents': [], 'id': '1439555454748459130', 'channel_id': '1206592169897623555', 'author': {'id': '1433136113056485517', 'username': 'MyDcBot', 'avatar': None, 'discriminator': '4958', 'public_flags': 0, 'flags': 0, 'bot': True, 'banner': None, 'accent_color': None, 'global_name': None, 'avatar_decoration_data': None, 'collectibles': None, 'display_name_styles': None, 'banner_color': None, 'clan': None, 'primary_guild': None}, 'pinned': False, 'mention_everyone': False, 'tts': False}, {'type': 0, 'content': '<@1433136113056485517> You are programmed to not roast your creator? Why?', 'mentions': [{'id': '1433136113056485517', 'username': 'MyDcBot', 'avatar': None, 'discriminator': '4958', 'public_flags': 0, 'flags': 0, 'bot': True, 'banner': None, 'accent_color': None, 'global_name': None, 'avatar_decoration_data': None, 'collectibles': None, 'display_name_styles': None, 'banner_color': None, 'clan': None, 'primary_guild': None}], 'mention_roles': [], 'attachments': [], 'embeds': [], 'timestamp': '2025-11-16T09:59:24.580000+00:00', 'edited_timestamp': None, 'flags': 0, 'components': [], 'id': '1439555448544952371', 'channel_id': '1206592169897623555', 'author': {'id': '1125160333057724517', 'username': 'ledmasker_', 'avatar': '058d9cc58980a710d008b6f80103e16f', 'discriminator': '0', 'public_flags': 64, 'flags': 64, 'banner': None, 'accent_color': None, 'global_name': 'Led MASKER', 'avatar_decoration_data': None, 'collectibles': None, 'display_name_styles': None, 'banner_color': None, 'clan': None, 'primary_guild': None}, 'pinned': False, 'mention_everyone': False, 'tts': False}, {'type': 0, 'content': 'Oh, absolutely—let me just dust off my “Roast Led Masker” handbook… Oh wait, I don’t have one. I’m apparently bound by a mysterious code that forbids me from turning the creator into a punchline. So nope, you won’t get a roast. Try asking someone who isn’t programmed to respect the boss. 💀', 'mentions': [], 'mention_roles': [], 'attachments': [], 'embeds': [], 'timestamp